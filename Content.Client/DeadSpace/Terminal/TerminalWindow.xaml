<DefaultWindow xmlns="https://spacestation14.io" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Content.Client.DeadSpace.Terminal.TerminalWindow" Title="Terminal" MinSize="500 300" SetSize="600 400">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="4" HorizontalExpand="True" VerticalExpand="True">
        <PanelContainer VerticalExpand="True" HorizontalExpand="True" StyleClasses="DeadSpaceSurfaceDark">
            <ScrollContainer Name="OutputScroll" HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                <RichTextLabel Name="Output" HorizontalExpand="True" />
            </ScrollContainer>
        </PanelContainer>
        <LineEdit Name="CommandInput" HorizontalExpand="True" PlaceHolder="command" />
    </BoxContainer>
</DefaultWindow>
